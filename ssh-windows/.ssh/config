# Windows OpenSSH config.
# Separate from ssh/.ssh/config because Windows OpenSSH rejects `UseKeychain`
# (an Apple-only extension) and aborts the whole connection on an unknown keyword.

Host *
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/id_rsa
  ServerAliveInterval 60
  ServerAliveCountMax 3
